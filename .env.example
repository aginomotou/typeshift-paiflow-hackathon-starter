# Server-only configuration. Missing PAIFLOW_MODE defaults to prepare.
# prepare: no wallet actions, payments or event polling.
# Integration and test payments are allowed before the event.
# Select team once your deployment/token are ready, or demo for the shared XLM deployment.
PAIFLOW_MODE=prepare
PAIFLOW_BASE_URL=https://beta.app.paiflow.xyz
PAIFLOW_API_TOKEN=
PAIFLOW_DEPLOYMENT_ID=

# Optional Webhook helper only; never NEXT_PUBLIC_. Store event key/payload durably.
# PAIFLOW_WEBHOOK_SECRET=

# PUNDAR: public G-addresses of the three Split recipients, in the flow's order.
# Must match the deployed Split exactly. Server-configured; never NEXT_PUBLIC_.
PUNDAR_HOUSEHOLD_ADDRESS=
PUNDAR_STUDENT_ADDRESS=
PUNDAR_SAVINGS_ADDRESS=

# PUNDAR locked padala (#5): a SECOND deployment (On Receive -> Condition
# time_after -> before: Hold / after: Split 60/15/25). Server-only; never
# NEXT_PUBLIC_. UNLOCK_AT must equal the Condition's time (ISO with timezone).
PUNDAR_LOCKED_DEPLOYMENT_ID=
PUNDAR_LOCKED_API_TOKEN=
PUNDAR_LOCKED_UNLOCK_AT=
